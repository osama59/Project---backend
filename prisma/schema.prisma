// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String
  firstName       String
  lastName        String
  age             Int
  origin          String
  profileImageUrl String?
  timeZone        String
  role            Role       @default(STUDENT)
  student         Student?
  teacher         Teacher?
  createdAt       DateTime   @default(now())
  languages       Language[]
  subjects        String[]
}

model Student {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id])
  preferedPriceMin    Float
  preferedPriceMax    Float
  studentRateTeachers StudentRateTeacher[]

  sessions Session[]

  ratings Rating[]
}

model Teacher {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id])
  certificateImageUrl String?
  introText           String
  introVideoUrl       String
  hourPrice           Float
  studentRateTeachers StudentRateTeacher[]
  availabilities      Availability[]

  sessions Session[]

  ratings Rating[]
}

model Language {
  id           String       @id @default(uuid())
  name         String
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  level        Int //0 - 5
  languageType LanguageType
}

model Availability {
  id        String  @id @default(uuid())
  day       Days
  fromTime DateTime @db.Time(0)
  toTime DateTime @db.Time(0)
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String
}

model StudentRateTeacher {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
}

model Session {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  startTime   DateTime
  endTime     DateTime
  status      SessionStatus @default(PENDING)
  createdAt   DateTime @default(now())

  ratings Rating[]
}


model Rating {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  sessionId String   @unique // One rating per session
  session   Session  @relation(fields: [sessionId], references: [id])
  rating    Int      // 1-5
  review    String?
  createdAt DateTime @default(now())
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LanguageType {
  SPEAK
  TEACH
  LEARN
}

enum Days {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
