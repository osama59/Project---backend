// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid())
  password        String
  email           String     @unique
  firstName       String
  lastName        String
  age             Int
  origin          String
  profileImageUrl String?
  timeZone        String
  role            Role       @default(STUDENT)
  student         Student?
  teacher         Teacher?
  createdAt       DateTime   @default(now())
  languages       Language[]
  subjects        String[]
}

model Student {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id])
  preferedPriceMin    Float
  preferedPriceMax    Float
  studentRateTeachers StudentRateTeacher[]
}

model Teacher {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id])
  certificateImageUrl String?
  introText           String
  introVideoUrl       String
  hourPrice           Float
  studentRateTeachers StudentRateTeacher[]
  availabilities      Availability[]
}

model Language {
  id           String       @id @default(uuid())
  name         String
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  level        Int //0 - 5
  languageType LanguageType
}

model Availability {
  id        String  @id @default(uuid())
  userId    String
  day       Days
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String
}

model StudentRateTeacher {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LanguageType {
  SPEAK
  TEACHE
  LEARN
}

enum Days {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
