// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid())
  googleId        String?    @unique
  email           String     @unique
  password        String
  firstName       String
  lastName        String
  birthDate       DateTime
  origin          String
  profileImageUrl String?
  timeZone        String
  role            Role       @default(STUDENT)
  student         Student?
  teacher         Teacher?
  createdAt       DateTime   @default(now())
  languages       Language[]
  subjects        String[]
  status          UserStatus @default(PENDING)
  balance         Float      @default(0.0)
  verifyCode      Int        @default(0) // 6 random digits

  sentMessages   Message[] @relation(name: "sentMessages")
  recivedMessages Message[] @relation(name: "recivedMessages")
}

model Student {
  id               String @id @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id])
  preferedPriceMin Float
  preferedPriceMax Float

  sessions Session[]

  ratings Rating[]

  transactions Transaction[]
}

model Teacher {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id])
  certificateImageUrl String?
  introText           String
  introVideoUrl       String
  hourPrice           Float
  availabilities      Availability[]

  sessions Session[]

  ratings Rating[]

  transactions Transaction[]
}

model Language {
  id           String       @id @default(uuid())
  name         String
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  level        Int //0 - 5
  languageType LanguageType
}

model Availability {
  id        String   @id @default(uuid())
  day       Days
  fromTime  DateTime @db.Time(0)
  toTime    DateTime @db.Time(0)
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  teacherId String
}

model Session {
  id        String        @id @default(uuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   Teacher       @relation(fields: [teacherId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    SessionStatus @default(PENDING)
  createdAt DateTime      @default(now())

  ratings Rating[]

  transactions Transaction[]
}

model Rating {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  sessionId String   @unique // One rating per session
  session   Session  @relation(fields: [sessionId], references: [id])
  rating    Int // 1-5
  review    String?
  createdAt DateTime @default(now())
}

model Transaction {
  id              String            @id @default(uuid())
  sessionId       String            @unique
  session         Session           @relation(fields: [sessionId], references: [id])
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id])
  teacherId       String
  teacher         Teacher           @relation(fields: [teacherId], references: [id])
  scheduledAmount Float // Total based on scheduled duration (e.g., $30)
  actualAmount    Float? // Final amount based on actual duration (e.g., $22)
  platformFee     Float // Platform cut (e.g., 20% of actual)
  teacherEarn     Float? // Teacher gets (e.g., $17.60)
  status          TransactionStatus @default(ESCROW)
  createdAt       DateTime          @default(now())
  releasedAt      DateTime? // When the money was released to the teacher
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  sender    User     @relation(name: "sentMessages", fields: [senderId], references: [id])
  reciverId String
  reciver   User     @relation(name: "recivedMessages", fields: [reciverId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

enum TransactionStatus {
  ESCROW // Money is held, session pending
  RELEASED // Teacher got paid
  REFUNDED // Student got refund
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LanguageType {
  SPEAK
  TEACH
  LEARN
}

enum UserStatus {
  PENDING //When user first sign up 🟡
  CONFIRMED //Email confirmed 🟢
  APPROVED //teacher approved 🟢
  REJECTED //teacher rejected 🔴
  SUSBENDED // user susbended 🔴
}

enum Days {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
